{% comment %}
  PedhPaudha full-width homepage slideshow.
{% endcomment %}

<section
  class="pp-hero-section"
  aria-label="PedhPaudha featured collections"
  data-pp-hero
  data-autoplay="true"
>
  <div class="pp-hero-slides" aria-live="off">
    <article class="pp-hero-slide is-active" data-pp-slide aria-hidden="false">
      <div class="pp-hero-inner pp-container">
        <div class="pp-hero-content">
          <p class="pp-hero-eyebrow"><span>THE ART OF GROWING</span><span class="pp-hero-eyebrow-line" aria-hidden="true"></span></p>
          <h1 class="pp-hero-heading">Everything You<br>Need to <em>Grow.</em></h1>
          <p class="pp-hero-subtitle">From a tiny seed to a beautiful garden. Discover thoughtfully crafted tools, smart irrigation, and powerful equipment for every green space.</p>
          <div class="pp-hero-actions">
            <a href="/collections/all" class="pp-btn-shop" aria-label="Shop all gardening products"><span>Shop Now</span><span class="pp-btn-arrow-circle" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span></a>
            <p class="pp-hero-supporting"><span aria-hidden="true">🌱</span> For every grower. For every green space.</p>
          </div>
        </div>
        <div class="pp-hero-visual-wrapper">
          <picture class="pp-hero-picture">
            <source media="(max-width: 768px)" srcset="{{ 'pedhpaudha-mobile-slide-1.jpg' | asset_url }}">
            <img src="{{ 'pedhpaudha-fullscreen-slide-1.jpg' | asset_url }}" alt="Sunlit home garden with lush tropical plants, elegant planters, and gardening essentials" class="pp-hero-visual-img" width="1672" height="941" fetchpriority="high">
          </picture>
          <a class="pp-hero-mobile-cta pp-hero-mobile-cta--1" href="/collections/all" aria-label="Shop Now"></a>
        </div>
      </div>
    </article>

    <article class="pp-hero-slide" data-pp-slide aria-hidden="true" hidden>
      <div class="pp-hero-inner pp-container">
        <div class="pp-hero-content">
          <p class="pp-hero-eyebrow"><span>GROW SOMETHING GOOD</span><span class="pp-hero-eyebrow-line" aria-hidden="true"></span></p>
          <h2 class="pp-hero-heading">Your Own Little<br><em>Harvest.</em></h2>
          <p class="pp-hero-subtitle">Turn a sunny corner into a kitchen garden. Find the seeds, planters, and essentials that make growing at home feel simple.</p>
          <div class="pp-hero-actions">
            <a href="#category-plants" class="pp-btn-shop"><span>Start Growing</span><span class="pp-btn-arrow-circle" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span></a>
            <p class="pp-hero-supporting"><span aria-hidden="true">🌿</span> Fresh-picked joy, right at home.</p>
          </div>
        </div>
        <div class="pp-hero-visual-wrapper">
          <picture class="pp-hero-picture">
            <source media="(max-width: 768px)" srcset="{{ 'pedhpaudha-mobile-slide-2.jpg' | asset_url }}">
            <img src="{{ 'pedhpaudha-fullscreen-slide-2.jpg' | asset_url }}" alt="A thriving kitchen garden with fresh herbs, greens, and tomatoes" class="pp-hero-visual-img" width="1672" height="941" loading="lazy">
          </picture>
          <a class="pp-hero-mobile-cta pp-hero-mobile-cta--2" href="#category-plants" aria-label="Start Growing"></a>
        </div>
      </div>
    </article>

    <article class="pp-hero-slide" data-pp-slide aria-hidden="true" hidden>
      <div class="pp-hero-inner pp-container">
        <div class="pp-hero-content">
          <p class="pp-hero-eyebrow"><span>TOOLS THAT WORK AS HARD AS YOU</span><span class="pp-hero-eyebrow-line" aria-hidden="true"></span></p>
          <h2 class="pp-hero-heading">Make Every<br>Garden <em>Thrive.</em></h2>
          <p class="pp-hero-subtitle">From everyday hand tools to powerful lawn care, get dependable equipment that helps you do more outdoors.</p>
          <div class="pp-hero-actions">
            <a href="#category-tools" class="pp-btn-shop"><span>Explore Garden Tools</span><span class="pp-btn-arrow-circle" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span></a>
            <p class="pp-hero-supporting"><span aria-hidden="true">🛠️</span> Trusted essentials for every season.</p>
          </div>
        </div>
        <div class="pp-hero-visual-wrapper">
          <picture class="pp-hero-picture">
            <source media="(max-width: 768px)" srcset="{{ 'pedhpaudha-mobile-slide-3.jpg' | asset_url }}">
            <img src="{{ 'pedhpaudha-fullscreen-slide-3.jpg' | asset_url }}" alt="A garden mower and hand tools in a fresh green home garden" class="pp-hero-visual-img" width="1672" height="941" loading="lazy">
          </picture>
          <a class="pp-hero-mobile-cta pp-hero-mobile-cta--3" href="#category-tools" aria-label="Explore Garden Tools"></a>
        </div>
      </div>
    </article>
  </div>

  <div class="pp-hero-controls pp-container" aria-label="Slideshow controls">
    <div class="pp-hero-pagination" role="group" aria-label="Choose a slide">
      <button class="pp-hero-dot is-active" type="button" aria-label="Show slide 1 of 3" aria-current="true" data-pp-dot="0"></button>
      <button class="pp-hero-dot" type="button" aria-label="Show slide 2 of 3" data-pp-dot="1"></button>
      <button class="pp-hero-dot" type="button" aria-label="Show slide 3 of 3" data-pp-dot="2"></button>
    </div>
    <div class="pp-hero-control-actions">
      <span class="pp-hero-slide-count"><strong data-pp-current>01</strong><span aria-hidden="true"> / </span>03</span>
      <button class="pp-hero-arrow" type="button" aria-label="Previous slide" data-pp-prev><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
      <button class="pp-hero-arrow" type="button" aria-label="Next slide" data-pp-next><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
    </div>
  </div>
</section>

<script src="{{ 'pedhpaudha-hero.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "PedhPaudha Hero Slideshow",
  "settings": [],
  "presets": [
    {
      "name": "PedhPaudha Hero Slideshow"
    }
  ]
}
{% endschema %}
