{% comment %}
  PedhPaudha full-width homepage slideshow.
{% endcomment %}

<section
  class="pp-hero-section"
  aria-label="PedhPaudha featured collections"
  data-pp-hero
  data-autoplay="{{ section.settings.autoplay }}"
>
  <div class="pp-hero-slides" aria-live="off">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <article class="pp-hero-slide{% if forloop.first %} is-active{% endif %}" data-pp-slide aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"{% unless forloop.first %} hidden{% endunless %} {{ block.shopify_attributes }}>
          <div class="pp-hero-inner pp-container">
            <div class="pp-hero-content">
              <p class="pp-hero-eyebrow"><span>{{ block.settings.eyebrow | escape }}</span><span class="pp-hero-eyebrow-line" aria-hidden="true"></span></p>
              {% if forloop.first %}<h1 class="pp-hero-heading">{{ block.settings.heading_line_1 | escape }}<br>{{ block.settings.heading_line_2 | escape }} <em>{{ block.settings.emphasis | escape }}</em></h1>{% else %}<h2 class="pp-hero-heading">{{ block.settings.heading_line_1 | escape }}<br>{% if block.settings.heading_line_2 != blank %}{{ block.settings.heading_line_2 | escape }} {% endif %}<em>{{ block.settings.emphasis | escape }}</em></h2>{% endif %}
              <p class="pp-hero-subtitle">{{ block.settings.description | escape }}</p>
              <div class="pp-hero-actions">
                <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="pp-btn-shop"><span>{{ block.settings.button_label | escape }}</span><span class="pp-btn-arrow-circle" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span></a>
                <p class="pp-hero-supporting"><span aria-hidden="true">{{ block.settings.supporting_icon | escape }}</span> {{ block.settings.supporting | escape }}</p>
              </div>
            </div>
            <div class="pp-hero-visual-wrapper">
              <picture class="pp-hero-picture">
                {% if block.settings.mobile_image != blank %}<source media="(max-width: 768px)" srcset="{{ block.settings.mobile_image | image_url: width: 1400 }}">{% elsif block.settings.mobile_asset != blank %}<source media="(max-width: 768px)" srcset="{{ block.settings.mobile_asset | asset_url }}">{% endif %}
                {% if block.settings.desktop_image != blank %}
                  {% if forloop.first %}{{ block.settings.desktop_image | image_url: width: 2600 | image_tag: class: 'pp-hero-visual-img', loading: 'eager', fetchpriority: 'high', alt: block.settings.image_alt }}{% else %}{{ block.settings.desktop_image | image_url: width: 2600 | image_tag: class: 'pp-hero-visual-img', loading: 'lazy', alt: block.settings.image_alt }}{% endif %}
                {% elsif block.settings.desktop_asset != blank %}
                  <img src="{{ block.settings.desktop_asset | asset_url }}" alt="{{ block.settings.image_alt | escape }}" class="pp-hero-visual-img" width="1672" height="941" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
                {% endif %}
              </picture>
              <a class="pp-hero-mobile-cta pp-hero-mobile-cta--{{ block.settings.mobile_cta_position | default: '1' }}" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" aria-label="{{ block.settings.button_label | escape }}"></a>
            </div>
          </div>
        </article>
      {% endfor %}
    {% else %}
    <article class="pp-hero-slide is-active" data-pp-slide aria-hidden="false">
      <div class="pp-hero-inner pp-container">
        <div class="pp-hero-content">
          <p class="pp-hero-eyebrow"><span>{{ section.settings.slide_1_eyebrow | default: 'THE ART OF GROWING' | escape }}</span><span class="pp-hero-eyebrow-line" aria-hidden="true"></span></p>
          <h1 class="pp-hero-heading">{{ section.settings.slide_1_heading_line_1 | default: 'Everything You' | escape }}<br>{{ section.settings.slide_1_heading_line_2 | default: 'Need to' | escape }} <em>{{ section.settings.slide_1_emphasis | default: 'Grow.' | escape }}</em></h1>
          <p class="pp-hero-subtitle">{{ section.settings.slide_1_description | default: 'From a tiny seed to a beautiful garden. Discover thoughtfully crafted tools, smart irrigation, and powerful equipment for every green space.' | escape }}</p>
          <div class="pp-hero-actions">
            <a href="{{ section.settings.slide_1_button_link | default: routes.all_products_collection_url }}" class="pp-btn-shop" aria-label="{{ section.settings.slide_1_button_label | default: 'Shop all gardening products' | escape }}"><span>{{ section.settings.slide_1_button_label | default: 'Shop Now' | escape }}</span><span class="pp-btn-arrow-circle" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span></a>
            <p class="pp-hero-supporting"><span aria-hidden="true">🌱</span> {{ section.settings.slide_1_supporting | default: 'For every grower. For every green space.' | escape }}</p>
          </div>
        </div>
        <div class="pp-hero-visual-wrapper">
          <picture class="pp-hero-picture">
            {% if section.settings.slide_1_mobile_image != blank %}<source media="(max-width: 768px)" srcset="{{ section.settings.slide_1_mobile_image | image_url: width: 1200 }}">{% else %}<source media="(max-width: 768px)" srcset="{{ 'pedhpaudha-mobile-slide-1.jpg' | asset_url }}">{% endif %}
            {% if section.settings.slide_1_desktop_image != blank %}{{ section.settings.slide_1_desktop_image | image_url: width: 2400 | image_tag: class: 'pp-hero-visual-img', loading: 'eager', fetchpriority: 'high', alt: section.settings.slide_1_image_alt }}{% else %}<img src="{{ 'pedhpaudha-fullscreen-slide-1.jpg' | asset_url }}" alt="{{ section.settings.slide_1_image_alt | default: 'Sunlit home garden with lush tropical plants, elegant planters, and gardening essentials' | escape }}" class="pp-hero-visual-img" width="1672" height="941" fetchpriority="high">{% endif %}
          </picture>
          <a class="pp-hero-mobile-cta pp-hero-mobile-cta--1" href="{{ routes.all_products_collection_url }}" aria-label="Shop Now"></a>
        </div>
      </div>
    </article>

    <article class="pp-hero-slide" data-pp-slide aria-hidden="true" hidden>
      <div class="pp-hero-inner pp-container">
        <div class="pp-hero-content">
          <p class="pp-hero-eyebrow"><span>{{ section.settings.slide_2_eyebrow | default: 'GROW SOMETHING GOOD' | escape }}</span><span class="pp-hero-eyebrow-line" aria-hidden="true"></span></p>
          <h2 class="pp-hero-heading">{{ section.settings.slide_2_heading_line_1 | default: 'Your Own Little' | escape }}<br><em>{{ section.settings.slide_2_emphasis | default: 'Harvest.' | escape }}</em></h2>
          <p class="pp-hero-subtitle">{{ section.settings.slide_2_description | default: 'Turn a sunny corner into a kitchen garden. Find the seeds, planters, and essentials that make growing at home feel simple.' | escape }}</p>
          <div class="pp-hero-actions">
            <a href="{{ section.settings.slide_2_button_link | default: '#category-plants' }}" class="pp-btn-shop"><span>{{ section.settings.slide_2_button_label | default: 'Start Growing' | escape }}</span><span class="pp-btn-arrow-circle" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span></a>
            <p class="pp-hero-supporting"><span aria-hidden="true">🌿</span> {{ section.settings.slide_2_supporting | default: 'Fresh-picked joy, right at home.' | escape }}</p>
          </div>
        </div>
        <div class="pp-hero-visual-wrapper">
          <picture class="pp-hero-picture">
            {% if section.settings.slide_2_mobile_image != blank %}<source media="(max-width: 768px)" srcset="{{ section.settings.slide_2_mobile_image | image_url: width: 1200 }}">{% else %}<source media="(max-width: 768px)" srcset="{{ 'pedhpaudha-mobile-slide-2.jpg' | asset_url }}">{% endif %}
            {% if section.settings.slide_2_desktop_image != blank %}{{ section.settings.slide_2_desktop_image | image_url: width: 2400 | image_tag: class: 'pp-hero-visual-img', loading: 'lazy', alt: section.settings.slide_2_image_alt }}{% else %}<img src="{{ 'pedhpaudha-fullscreen-slide-2.jpg' | asset_url }}" alt="{{ section.settings.slide_2_image_alt | default: 'A thriving kitchen garden with fresh herbs, greens, and tomatoes' | escape }}" class="pp-hero-visual-img" width="1672" height="941" loading="lazy">{% endif %}
          </picture>
          <a class="pp-hero-mobile-cta pp-hero-mobile-cta--2" href="#category-plants" aria-label="Start Growing"></a>
        </div>
      </div>
    </article>

    <article class="pp-hero-slide" data-pp-slide aria-hidden="true" hidden>
      <div class="pp-hero-inner pp-container">
        <div class="pp-hero-content">
          <p class="pp-hero-eyebrow"><span>{{ section.settings.slide_3_eyebrow | default: 'TOOLS THAT WORK AS HARD AS YOU' | escape }}</span><span class="pp-hero-eyebrow-line" aria-hidden="true"></span></p>
          <h2 class="pp-hero-heading">{{ section.settings.slide_3_heading_line_1 | default: 'Make Every' | escape }}<br>{{ section.settings.slide_3_heading_line_2 | default: 'Garden' | escape }} <em>{{ section.settings.slide_3_emphasis | default: 'Thrive.' | escape }}</em></h2>
          <p class="pp-hero-subtitle">{{ section.settings.slide_3_description | default: 'From everyday hand tools to powerful lawn care, get dependable equipment that helps you do more outdoors.' | escape }}</p>
          <div class="pp-hero-actions">
            <a href="{{ section.settings.slide_3_button_link | default: '#category-tools' }}" class="pp-btn-shop"><span>{{ section.settings.slide_3_button_label | default: 'Explore Garden Tools' | escape }}</span><span class="pp-btn-arrow-circle" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span></a>
            <p class="pp-hero-supporting"><span aria-hidden="true">🛠️</span> {{ section.settings.slide_3_supporting | default: 'Trusted essentials for every season.' | escape }}</p>
          </div>
        </div>
        <div class="pp-hero-visual-wrapper">
          <picture class="pp-hero-picture">
            {% if section.settings.slide_3_mobile_image != blank %}<source media="(max-width: 768px)" srcset="{{ section.settings.slide_3_mobile_image | image_url: width: 1200 }}">{% else %}<source media="(max-width: 768px)" srcset="{{ 'pedhpaudha-mobile-slide-3.jpg' | asset_url }}">{% endif %}
            {% if section.settings.slide_3_desktop_image != blank %}{{ section.settings.slide_3_desktop_image | image_url: width: 2400 | image_tag: class: 'pp-hero-visual-img', loading: 'lazy', alt: section.settings.slide_3_image_alt }}{% else %}<img src="{{ 'pedhpaudha-fullscreen-slide-3.jpg' | asset_url }}" alt="{{ section.settings.slide_3_image_alt | default: 'A garden mower and hand tools in a fresh green home garden' | escape }}" class="pp-hero-visual-img" width="1672" height="941" loading="lazy">{% endif %}
          </picture>
          <a class="pp-hero-mobile-cta pp-hero-mobile-cta--3" href="#category-tools" aria-label="Explore Garden Tools"></a>
        </div>
      </div>
    </article>
    {% endif %}
  </div>

  <div class="pp-hero-controls pp-container" aria-label="Slideshow controls">
    <div class="pp-hero-pagination" role="group" aria-label="Choose a slide">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}<button class="pp-hero-dot{% if forloop.first %} is-active{% endif %}" type="button" aria-label="Show slide {{ forloop.index }} of {{ section.blocks.size }}"{% if forloop.first %} aria-current="true"{% endif %} data-pp-dot="{{ forloop.index0 }}"></button>{% endfor %}
      {% else %}
      <button class="pp-hero-dot is-active" type="button" aria-label="Show slide 1 of 3" aria-current="true" data-pp-dot="0"></button>
      <button class="pp-hero-dot" type="button" aria-label="Show slide 2 of 3" data-pp-dot="1"></button>
      <button class="pp-hero-dot" type="button" aria-label="Show slide 3 of 3" data-pp-dot="2"></button>
      {% endif %}
    </div>
    <div class="pp-hero-control-actions">
      <span class="pp-hero-slide-count"><strong data-pp-current>01</strong><span aria-hidden="true"> / </span>{% if section.blocks.size > 0 %}{{ section.blocks.size | prepend: '0' }}{% else %}03{% endif %}</span>
      <button class="pp-hero-arrow" type="button" aria-label="Previous slide" data-pp-prev><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
      <button class="pp-hero-arrow" type="button" aria-label="Next slide" data-pp-next><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
    </div>
  </div>
</section>

<script src="{{ 'pedhpaudha-hero.js' | asset_url }}" defer></script>

