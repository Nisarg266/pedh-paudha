{% comment %}
  PedhPaudha Premium Multi-Column Footer
{% endcomment %}

<footer class="pp-footer" aria-label="Site Footer">
  <div class="pp-container">
    <div class="pp-footer-grid">
      <!-- Column 1: Brand & Logo -->
      <div class="pp-footer-brand">
        <a href="{{ routes.root_url }}" class="pp-footer-logo-link" aria-label="PedhPaudha Home">
          {% assign footer_logo = section.settings.logo_image | default: settings.logo %}
          {% if footer_logo != blank %}{{ footer_logo | image_url: width: 400 | image_tag: class: 'pp-footer-logo-img', loading: 'lazy', alt: section.settings.logo_alt }}{% else %}<img src="https://cdn.shopify.com/s/files/1/1012/3345/9510/files/PedhPaudha_Sunscape_Logo.png?v=1795074452" alt="{{ section.settings.logo_alt | escape }}" class="pp-footer-logo-img" width="150" height="88" loading="lazy">{% endif %}
        </a>
        <p class="pp-footer-desc">{{ section.settings.description | default: 'Everything you need to grow, nurture and maintain beautiful green spaces. Engineered for modern growers and commercial nurseries.' | escape }}</p>
        {% if section.settings.instagram_url != blank or section.settings.facebook_url != blank or section.settings.youtube_url != blank %}<div class="pp-footer-socials">
          {% if section.settings.instagram_url != blank %}<a href="{{ section.settings.instagram_url }}" class="pp-social-btn" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>{% endif %}
          {% if section.settings.facebook_url != blank %}<a href="{{ section.settings.facebook_url }}" class="pp-social-btn" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>{% endif %}
          {% if section.settings.youtube_url != blank %}<a href="{{ section.settings.youtube_url }}" class="pp-social-btn" aria-label="YouTube">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg>
          </a>{% endif %}
        </div>{% endif %}
      </div>

      <!-- Column 2: Shop -->
      <div class="pp-footer-col pp-footer-shop">
        <h4 class="pp-footer-col-title">{{ section.settings.shop_heading | default: 'Shop Equipment' | escape }}</h4>
        <ul class="pp-footer-links">
          {% if section.settings.shop_menu != blank %}{% for link in section.settings.shop_menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}{% else %}
            <li><a href="{{ routes.all_products_collection_url }}">All Products</a></li><li><a href="#category-tools">Hand Garden Tools</a></li><li><a href="#category-machines">Garden Machines</a></li><li><a href="#category-irrigation">Watering &amp; Irrigation</a></li><li><a href="#category-soil">Growing Essentials</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Column 3: Explore -->
      <div class="pp-footer-col pp-footer-explore">
        <h4 class="pp-footer-col-title">{{ section.settings.explore_heading | default: 'Explore' | escape }}</h4>
        <ul class="pp-footer-links">
          {% if section.settings.explore_menu != blank %}{% for link in section.settings.explore_menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}{% else %}
            <li><a href="#why-pedhpaudha">About Us</a></li><li><a href="#starter-kits">Beginner Starter Kits</a></li><li><a href="#products">Bestsellers</a></li><li><a href="#machinery">Commercial Machinery</a></li><li><a href="#collections">All Collections</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Column 4: Customer Care -->
      <div class="pp-footer-col pp-footer-care">
        <h4 class="pp-footer-col-title">{{ section.settings.care_heading | default: 'Customer Care' | escape }}</h4>
        <ul class="pp-footer-links">
          {% if section.settings.care_menu != blank %}
            {% for link in section.settings.care_menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}
          {% else %}
            {% assign rendered_policy_links = false %}
            {% if shop.shipping_policy != blank %}<li><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title | escape }}</a></li>{% assign rendered_policy_links = true %}{% endif %}
            {% if shop.refund_policy != blank %}<li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title | escape }}</a></li>{% assign rendered_policy_links = true %}{% endif %}
            {% if shop.privacy_policy != blank %}<li><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | escape }}</a></li>{% assign rendered_policy_links = true %}{% endif %}
            {% if shop.terms_of_service != blank %}<li><a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title | escape }}</a></li>{% assign rendered_policy_links = true %}{% endif %}
            {% assign contact_page = pages['contact'] %}{% if contact_page != blank %}<li><a href="{{ contact_page.url }}">{{ contact_page.title | escape }}</a></li>{% assign rendered_policy_links = true %}{% endif %}
            {% unless rendered_policy_links %}<li><a href="#">Shipping Policy</a></li><li><a href="#">Returns &amp; Refunds</a></li><li><a href="#">Privacy Policy</a></li><li><a href="#">Terms of Service</a></li><li><a href="#">Contact Support</a></li>{% endunless %}
          {% endif %}
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright & Badges -->
    <div class="pp-footer-bottom">
      <div>{{ section.settings.copyright_prefix | escape }} © {{ 'now' | date: '%Y' }} {{ shop.name | escape }}{% if section.settings.copyright_suffix != blank %}. {{ section.settings.copyright_suffix | escape }}{% endif %}</div>
      {% if section.settings.trust_note_one != blank or section.settings.trust_note_two != blank %}<div class="pp-footer-trust-notes" style="display:flex; align-items:center; gap:16px;">
        {% if section.settings.trust_note_one != blank %}<span>{{ section.settings.trust_note_one | escape }}</span>{% endif %}
        {% if section.settings.trust_note_two != blank %}<span>{{ section.settings.trust_note_two | escape }}</span>{% endif %}
      </div>{% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "PedhPaudha Footer",
  "settings": [
    { "type": "image_picker", "id": "logo_image", "label": "Footer logo" },
    { "type": "text", "id": "logo_alt", "label": "Logo description", "default": "PedhPaudha" },
    { "type": "textarea", "id": "description", "label": "Brand description" },
    { "type": "url", "id": "instagram_url", "label": "Instagram link" },
    { "type": "url", "id": "facebook_url", "label": "Facebook link" },
    { "type": "url", "id": "youtube_url", "label": "YouTube link" },
    { "type": "text", "id": "shop_heading", "label": "Shop column heading", "default": "Shop Equipment" },
    { "type": "link_list", "id": "shop_menu", "label": "Shop column menu", "default": "footer" },
    { "type": "text", "id": "explore_heading", "label": "Explore column heading", "default": "Explore" },
    { "type": "link_list", "id": "explore_menu", "label": "Explore column menu", "default": "main-menu" },
    { "type": "text", "id": "care_heading", "label": "Care column heading", "default": "Customer Care" },
    { "type": "link_list", "id": "care_menu", "label": "Customer care menu" },
    { "type": "text", "id": "copyright_prefix", "label": "Copyright prefix" },
    { "type": "text", "id": "copyright_suffix", "label": "Copyright suffix" },
    { "type": "text", "id": "trust_note_one", "label": "Trust note 1" },
    { "type": "text", "id": "trust_note_two", "label": "Trust note 2" }
  ]
}
{% endschema %}
