{% comment %}
  PedhPaudha Why Choose Us Section
  4 Benefit cards highlighting brand trust and quality
{% endcomment %}

<section class="pp-why-section" id="why-pedhpaudha" aria-label="Why PedhPaudha">
  <div class="pp-container">
    <div style="text-align:center; max-width:640px; margin:0 auto 44px auto;">
      <div class="pp-subheading-tag">{{ section.settings.eyebrow | default: 'THE PEDHPAUDHA PROMISE' | escape }}</div>
      <h2 class="pp-section-title">{{ section.settings.heading | default: 'Growing Together, Naturally.' | escape }}</h2>
      <p style="font-family:var(--pp-font-body); font-size:1.05rem; color:var(--pp-text-secondary); margin-top:8px;">
        {{ section.settings.description | default: 'Thoughtfully designed equipment engineered for durable performance and thriving gardens.' | escape }}
      </p>
    </div>

    <div class="pp-why-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="pp-why-card" {{ block.shopify_attributes }}>
            <div class="pp-why-icon">
              {% case block.settings.icon %}
                {% when 'clock' %}<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                {% when 'shield' %}<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {% when 'compass' %}<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m16.2 7.8-2.1 6.3-6.3 2.1 2.1-6.3 6.3-2.1Z"/></svg>
                {% else %}<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
              {% endcase %}
            </div>
            <h3 class="pp-why-title">{{ block.settings.title | escape }}</h3>
            <p class="pp-why-desc">{{ block.settings.description | escape }}</p>
          </div>
        {% endfor %}
      {% else %}
      <!-- Card 1 -->
      <div class="pp-why-card">
        <div class="pp-why-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <h3 class="pp-why-title">Tools for Every Grower</h3>
        <p class="pp-why-desc">Ergonomic essentials tailored for beginner window-sill pots to multi-acre farm orchards.</p>
      </div>

      <!-- Card 2 -->
      <div class="pp-why-card">
        <div class="pp-why-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 0 1 10 10c0 5.52-4.48 10-10 10S2 17.52 2 12A10 10 0 0 1 12 2z"/><path d="M12 6v6l4 2"/></svg>
        </div>
        <h3 class="pp-why-title">Complete Growing Solutions</h3>
        <p class="pp-why-desc">From soil preparation and seed starting to smart irrigation and organic pest defense.</p>
      </div>

      <!-- Card 3 -->
      <div class="pp-why-card">
        <div class="pp-why-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3 class="pp-why-title">Practical Equipment</h3>
        <p class="pp-why-desc">Rust-resistant forged metals, UV-stabilized virgin plastics and dependable electric motors.</p>
      </div>

      <!-- Card 4 -->
      <div class="pp-why-card">
        <div class="pp-why-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
        </div>
        <h3 class="pp-why-title">One Place to Explore More</h3>
        <p class="pp-why-desc">Discover curated collections matched to diverse Indian climates and growing seasons.</p>
      </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PedhPaudha Why Us",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE PEDHPAUDHA PROMISE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Growing Together, Naturally." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Thoughtfully designed equipment engineered for durable performance and thriving gardens." }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Promise card",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "tool", "options": [ { "value": "tool", "label": "Garden tool" }, { "value": "clock", "label": "Clock" }, { "value": "shield", "label": "Shield" }, { "value": "compass", "label": "Compass" } ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Tools for Every Grower" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Ergonomic essentials tailored for every growing space." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "PedhPaudha Why Us"
    }
  ]
}
{% endschema %}
