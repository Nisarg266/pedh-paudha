{% comment %}
  PedhPaudha Search & Quick Discovery Section
{% endcomment %}
{% assign filter_collection = section.settings.collection | default: collections.all %}

<section class="pp-search-section" id="pp-search-anchor" aria-label="Quick Discovery">
  <div class="pp-container">
    <div class="pp-search-box">
      <p class="pp-search-eyebrow">{{ section.settings.eyebrow | default: 'THE PEDHPAUDHA COLLECTION' | escape }}</p>
      <h2 class="pp-search-heading">{{ section.settings.heading | default: 'What Are You Looking to Grow?' | escape }}</h2>
      <p class="pp-search-sub">{{ section.settings.description | default: 'From plant care to planters and seasonal seeds, find what your garden needs.' | escape }}</p>

      <div class="pp-filter-slider">
        <button class="pp-filter-nav pp-filter-prev" type="button" aria-label="Scroll product filters left">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <div class="pp-filter-pills" role="group" aria-label="Filter products">
          <button class="pp-filter-pill active" data-filter="all">{{ section.settings.all_products_label | escape }}</button>
          {% if filter_collection != blank and filter_collection.products_count > 0 %}
            {% assign product_types = filter_collection.products | map: 'type' | uniq %}
            {% for product_type in product_types %}
              {% if product_type != blank %}<button class="pp-filter-pill" data-filter="{{ product_type | escape }}">{{ product_type | escape }}</button>{% endif %}
            {% endfor %}
          {% else %}
            <button class="pp-filter-pill" data-filter="Plant Nutrition">Plant Nutrition</button>
            <button class="pp-filter-pill" data-filter="Plant Protection">Plant Protection</button>
            <button class="pp-filter-pill" data-filter="Micronutrients">Micronutrients</button>
            <button class="pp-filter-pill" data-filter="Soil Care">Soil Care</button>
            <button class="pp-filter-pill" data-filter="Seed Starting">Seed Starting</button>
            <button class="pp-filter-pill" data-filter="Planters">Planters</button>
            <button class="pp-filter-pill" data-filter="Seasonal Seeds">Seasonal Seeds</button>
          {% endif %}
        </div>
        <button class="pp-filter-nav pp-filter-next" type="button" aria-label="Scroll product filters right">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PedhPaudha Search",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Shopify product collection for filters" },
    { "type": "text", "id": "all_products_label", "label": "All products button label", "default": "All Products" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE PEDHPAUDHA COLLECTION" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Are You Looking to Grow?" },
    { "type": "text", "id": "description", "label": "Description", "default": "From plant care to planters and seasonal seeds, find what your garden needs." }
  ],
  "presets": [
    {
      "name": "PedhPaudha Search"
    }
  ]
}
{% endschema %}
