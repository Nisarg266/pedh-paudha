<section class="pp-testimonials-section" aria-label="Customer Reviews">
  <div class="pp-container">
    <div style="text-align:center; max-width:640px; margin:0 auto 44px auto;">
      <div class="pp-subheading-tag">{{ section.settings.eyebrow | escape }}</div>
      <h2 class="pp-section-title">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.description != blank %}<p style="font-family:var(--pp-font-body); font-size:1.05rem; color:var(--pp-text-secondary); margin-top:8px;">{{ section.settings.description | escape }}</p>{% endif %}
    </div>
    <div class="pp-testimonials-grid">
      {% for block in section.blocks %}
        <article class="pp-testimonial-card" {{ block.shopify_attributes }}>
          <div>
            {% assign review_rating = block.settings.rating | default: 5 %}
            <div class="pp-test-stars" aria-label="{{ review_rating }} out of 5 stars">{% for star in (1..review_rating) %}★{% endfor %}</div>
            <p class="pp-test-quote">"{{ block.settings.quote | escape }}"</p>
          </div>
          <div class="pp-test-author">
            <div class="pp-test-avatar">{{ block.settings.initials | escape }}</div>
            <div><h4 class="pp-test-name">{{ block.settings.name | escape }}</h4><p class="pp-test-role">{{ block.settings.role | escape }}</p></div>
          </div>
        </article>
      {% endfor %}
      {% if section.blocks.size == 0 %}
        <article class="pp-testimonial-card"><div><div class="pp-test-stars">★★★★★</div><p class="pp-test-quote">“PedhPaudha completely changed my urban balcony setup. The tools are weighted with real quality, and the starter kits gave my cherry tomatoes and basil the best beginning.”</p></div><div class="pp-test-author"><div class="pp-test-avatar">AS</div><div><h4 class="pp-test-name">Ananya Sharma</h4><p class="pp-test-role">Balcony Gardener, New Delhi · Verified Grower</p></div></div></article>
        <article class="pp-testimonial-card"><div><div class="pp-test-stars">★★★★★</div><p class="pp-test-quote">“Finding durable, commercial-grade irrigation fittings and electric sprayers in one place used to be impossible. PedhPaudha has become our nursery’s trusted equipment partner.”</p></div><div class="pp-test-author"><div class="pp-test-avatar">VR</div><div><h4 class="pp-test-name">Vikramaditya Roy</h4><p class="pp-test-role">Horticulturist &amp; Nursery Owner, Pune · Verified Grower</p></div></div></article>
        <article class="pp-testimonial-card"><div><div class="pp-test-stars">★★★★★</div><p class="pp-test-quote">“The pruning shears cut cleanly, and the product quality and helpful growing tips make shopping a pleasure.”</p></div><div class="pp-test-author"><div class="pp-test-avatar">DM</div><div><h4 class="pp-test-name">Devika Menon</h4><p class="pp-test-role">Kitchen Garden Enthusiast, Bengaluru · Verified Grower</p></div></div></article>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PedhPaudha Reviews",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "COMMUNITY VOICES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Growing Stories." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Real experiences from passionate gardeners and nursery growers across India." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Grower review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Star rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Review" },
        { "type": "text", "id": "initials", "label": "Avatar initials" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Location and grower type" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "PedhPaudha Reviews"
    }
  ]
}
{% endschema %}
