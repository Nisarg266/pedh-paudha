{% comment %}
  PedhPaudha Testimonials - Growing Stories
{% endcomment %}

<section class="pp-testimonials-section" aria-label="Customer Reviews">
  <div class="pp-container">
    <div style="text-align:center; max-width:640px; margin:0 auto 44px auto;">
      <div class="pp-subheading-tag">COMMUNITY VOICES</div>
      <h2 class="pp-section-title">Growing Stories.</h2>
      <p style="font-family:var(--pp-font-body); font-size:1.05rem; color:var(--pp-text-secondary); margin-top:8px;">
        Real experiences from passionate gardeners and nursery growers across India.
      </p>
    </div>

    <div class="pp-testimonials-grid">
      <!-- Story 1 -->
      <div class="pp-testimonial-card">
        <div>
          <div class="pp-test-stars">★★★★★</div>
          <p class="pp-test-quote">
            "PedhPaudha completely changed my urban balcony setup. The tools are weighted with real quality, and the starter kits gave my cherry tomatoes and basil the best beginning."
          </p>
        </div>
        <div class="pp-test-author">
          <div class="pp-test-avatar">AS</div>
          <div>
            <h4 class="pp-test-name">Ananya Sharma</h4>
            <p class="pp-test-role">Balcony Gardener, New Delhi • Verified Grower</p>
          </div>
        </div>
      </div>

      <!-- Story 2 -->
      <div class="pp-testimonial-card">
        <div>
          <div class="pp-test-stars">★★★★★</div>
          <p class="pp-test-quote">
            "Finding durable, commercial-grade irrigation fittings and electric sprayers in one place used to be impossible. PedhPaudha has become our nursery's trusted primary equipment partner."
          </p>
        </div>
        <div class="pp-test-author">
          <div class="pp-test-avatar">VR</div>
          <div>
            <h4 class="pp-test-name">Vikramaditya Roy</h4>
            <p class="pp-test-role">Horticulturist & Nursery Owner, Pune • Verified Grower</p>
          </div>
        </div>
      </div>

      <!-- Story 3 -->
      <div class="pp-testimonial-card">
        <div>
          <div class="pp-test-stars">★★★★★</div>
          <p class="pp-test-quote">
            "The pruning shears cut cleanly without crushing the stems. The website aesthetic, product quality, and helpful growing tips make it the most pleasant shopping experience."
          </p>
        </div>
        <div class="pp-test-author">
          <div class="pp-test-avatar">DM</div>
          <div>
            <h4 class="pp-test-name">Devika Menon</h4>
            <p class="pp-test-role">Kitchen Garden Enthusiast, Bengaluru • Verified Grower</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PedhPaudha Reviews",
  "settings": [],
  "presets": [
    {
      "name": "PedhPaudha Reviews"
    }
  ]
}
{% endschema %}
