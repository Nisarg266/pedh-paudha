{% comment %}
  PedhPaudha equipment and machinery feature with an asymmetric editorial image collage.
{% endcomment %}

<section class="pp-journey-section" aria-labelledby="pp-journey-title">
  <div class="pp-container">
    <div class="pp-journey-panel">
      <div class="pp-journey-glow pp-journey-glow--one" aria-hidden="true"></div>
      <div class="pp-journey-glow pp-journey-glow--two" aria-hidden="true"></div>

      <div class="pp-journey-intro pp-journey-header">
        <span class="pp-journey-eyebrow">{{ section.settings.journey_eyebrow | default: 'A GENTLER WAY TO GROW' | escape }}</span>
        <h2 id="pp-journey-title">{{ section.settings.journey_heading_line_1 | default: 'A little care.' | escape }}<br><em>{{ section.settings.journey_heading_line_2 | default: 'A lot more green.' | escape }}</em></h2>
        <p>{{ section.settings.journey_description | default: 'Good gardens grow one thoughtful step at a time. Find a simple rhythm that feels right for your space.' | escape }}</p>
        <a class="pp-journey-link" href="{{ section.settings.journey_button_link | default: '#products' }}">
          {{ section.settings.journey_button_label | default: 'Explore plant care' | escape }}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
        </a>
      </div>

      <div class="pp-journey-visual">
        <figure class="pp-journey-photo">
          {% if section.settings.journey_image != blank %}
            {{ section.settings.journey_image | image_url: width: 1400 | image_tag: class: 'pp-journey-image', loading: 'lazy', alt: section.settings.journey_image_alt }}
          {% else %}
            <img src="{{ 'home-garden.webp' | asset_url }}" alt="{{ section.settings.journey_image_alt | default: 'A thriving home vegetable garden with fresh tomatoes and herbs' | escape }}" class="pp-journey-image" width="716" height="1024" loading="lazy">
          {% endif %}
          <figcaption><span class="pp-journey-photo-kicker">{{ section.settings.journey_photo_kicker | default: 'GROW SOMETHING GOOD' | escape }}</span><span>{{ section.settings.journey_photo_caption | default: 'A little space. A whole lot of life.' | escape }}</span></figcaption>
          <span class="pp-journey-photo-index" aria-hidden="true">01 <i></i> 03</span>
        </figure>
        <div class="pp-journey-steps" role="group" aria-label="Three simple steps for growing">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <article class="pp-journey-step" {{ block.shopify_attributes }}>
              <div class="pp-journey-step-top">
                <span class="pp-journey-step-icon" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="{% case block.settings.icon %}{% when 'water' %}24 38V20m0 10c-8 0-13-5-13-13 8 0 13 5 13 13Zm0-9c0-8 5-13 13-13 0 8-5 13-13 13Zm-9 20h18{% when 'bloom' %}24 39V25m0-5c-6 0-10-4-10-10 6 0 10 4 10 10Zm0-2c0-6 4-10 10-10 0 6-4 10-10 10Zm0 8c-5 0-8-3-8-8 5 0 8 3 8 8Zm0-2c0-5 3-8 8-8 0 5-3 8-8 8Zm-9 11h18{% else %}10 31c5-2 9-2 14 0s9 2 14 0M13 36c4-2 8-2 11 0 4 2 8 2 11 0M24 28V14m0 9c-7 0-11-4-11-11 7 0 11 4 11 11Zm0-6c0-7 4-11 11-11 0 7-4 11-11 11{% endcase %}" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <span class="pp-journey-number">{{ forloop.index | prepend: '0' }}</span>
              </div>
              <h3>{{ block.settings.title | escape }}</h3>
              <p>{{ block.settings.description | escape }}</p>
            </article>
          {% endfor %}
        {% else %}
        <article class="pp-journey-step">
          <div class="pp-journey-step-top">
            <span class="pp-journey-step-icon" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="M10 31c5-2 9-2 14 0s9 2 14 0M13 36c4-2 8-2 11 0 4 2 8 2 11 0M24 28V14m0 9c-7 0-11-4-11-11 7 0 11 4 11 11Zm0-6c0-7 4-11 11-11 0 7-4 11-11 11Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="pp-journey-number">01</span>
          </div>
          <h3>Make room</h3>
          <p>Choose a sunny corner, a container, and a plant you love.</p>
        </article>
        <article class="pp-journey-step">
          <div class="pp-journey-step-top">
            <span class="pp-journey-step-icon" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="M24 37V20m0 10c-8 0-13-5-13-13 8 0 13 5 13 13Zm0-9c0-8 5-13 13-13 0 8-5 13-13 13Zm-9 20h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="pp-journey-number">02</span>
          </div>
          <h3>Nourish gently</h3>
          <p>Keep watering steady and give roots the care they need.</p>
        </article>
        <article class="pp-journey-step">
          <div class="pp-journey-step-top">
            <span class="pp-journey-step-icon" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="M24 39V25m0-5c-6 0-10-4-10-10 6 0 10 4 10 10Zm0-2c0-6 4-10 10-10 0 6-4 10-10 10Zm0 8c-5 0-8-3-8-8 5 0 8 3 8 8Zm0-2c0-5 3-8 8-8 0 5-3 8-8 8Zm-9 11h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="pp-journey-number">03</span>
          </div>
          <h3>Watch it flourish</h3>
          <p>Stay curious, notice new growth, and enjoy the little wins.</p>
        </article>
        {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="pp-sourcing-section" id="machinery" aria-label="Garden Equipment Sourcing">
  <!-- Soft Dappled Sunlight / Leaf Ambient Shadow -->
  <div class="pp-sourcing-shadow-overlay" aria-hidden="true"></div>

  <div class="pp-container pp-sourcing-container">
    <div class="pp-sourcing-grid">
      <div class="pp-sourcing-col pp-col-editorial">
        <div class="pp-sourcing-header">
          <h2 class="pp-sourcing-title">
            <span class="pp-title-row">
              {{ section.settings.title_line_1 | default: 'precision equipment' }}
              <span class="pp-marker-wrap" aria-hidden="true">
                <img src="{{ 'sketch_scribble_trans.png' | asset_url }}" alt="" class="pp-marker-img" width="180" height="20">
              </span>
            </span>
            <span class="pp-title-row">{{ section.settings.title_line_2 | default: 'sourcing.' }}</span>
          </h2>
          <p class="pp-sourcing-desc">
            {{ section.settings.description | default: 'Equipment sourcing is a crucial step, reflecting our commitment to quality and durability. We carefully select professional garden machines, ergonomic hand tools and smart irrigation systems engineered for exceptional performance in caring for green spaces.' }}
          </p>
          <div class="pp-sourcing-btn-row">
            <a href="{{ section.settings.button_link | default: '#collections' }}" class="pp-sourcing-btn">
              {{ section.settings.button_label | default: 'all equipment' }}
            </a>
            <div class="pp-mobile-bottle-art" aria-hidden="true">
              <img src="{{ 'sketch_bottle_trans.png' | asset_url }}" alt="" class="pp-art-bottle-img" width="100" height="118">
            </div>
          </div>
        </div>

        <div class="pp-sourcing-card-wrap pp-card-desktop-flower">
          <div class="pp-sourcing-img-frame pp-frame-square">
            {%- if section.settings.image_3 != blank -%}
              {{ section.settings.image_3 | image_url: width: 700 | image_tag: class: 'pp-sourcing-img', loading: 'lazy', alt: section.settings.caption_3 }}
            {%- else -%}
              <img src="{{ 'kitchen-garden.webp' | asset_url }}" alt="Complex of botanical and wild plants" class="pp-sourcing-img" width="340" height="340" loading="lazy">
            {%- endif -%}
          </div>
          <p class="pp-sourcing-caption">{{ section.settings.caption_3 | default: 'Complex of botanical and wild plants' }}</p>
        </div>
      </div>

      <div class="pp-sourcing-col pp-col-sprig">
        <div class="pp-mobile-sprig-box" aria-hidden="true">
          <img src="{{ 'sketch_sprig_trans.png' | asset_url }}" alt="" class="pp-art-sprig-img" width="82" height="82">
        </div>
        <div class="pp-sourcing-card-wrap pp-card-machinery">
          <div class="pp-sourcing-img-frame pp-frame-medium">
            {%- if section.settings.image_1 != blank -%}
              {{ section.settings.image_1 | image_url: width: 800 | image_tag: class: 'pp-sourcing-img', loading: 'lazy', alt: section.settings.caption_1 }}
            {%- else -%}
              <img src="{{ 'machinery-feature.webp' | asset_url }}" alt="High-torque brush cutters and tillers" class="pp-sourcing-img" width="380" height="475" loading="lazy">
            {%- endif -%}
          </div>
          <p class="pp-sourcing-caption">{{ section.settings.caption_1 | default: 'High-torque brush cutters & tillers' }}</p>
        </div>
        <div class="pp-desktop-sprig-box" aria-hidden="true">
          <img src="{{ 'sketch_sprig_trans.png' | asset_url }}" alt="" class="pp-art-sprig-img" width="125" height="125">
        </div>
      </div>

      <div class="pp-sourcing-col pp-col-tall">
        <div class="pp-desktop-bottle-box" aria-hidden="true">
          <img src="{{ 'sketch_bottle_trans.png' | asset_url }}" alt="" class="pp-art-bottle-img" width="120" height="142">
        </div>
        <div class="pp-sourcing-card-wrap pp-card-turf">
          <div class="pp-sourcing-img-frame pp-frame-tall">
            {%- if section.settings.image_2 != blank -%}
              {{ section.settings.image_2 | image_url: width: 800 | image_tag: class: 'pp-sourcing-img', loading: 'lazy', alt: section.settings.caption_2 }}
            {%- else -%}
              <img src="{{ 'lawn-care.webp' | asset_url }}" alt="Precision turf and lawn equipment" class="pp-sourcing-img" width="380" height="530" loading="lazy">
            {%- endif -%}
          </div>
          <p class="pp-sourcing-caption">{{ section.settings.caption_2 | default: 'Precision turf & lawn care' }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PedhPaudha Machinery",
  "settings": [
    { "type": "header", "content": "Growing journey feature" },
    { "type": "text", "id": "journey_eyebrow", "label": "Journey eyebrow", "default": "A GENTLER WAY TO GROW" },
    { "type": "text", "id": "journey_heading_line_1", "label": "Journey heading, line 1", "default": "A little care." },
    { "type": "text", "id": "journey_heading_line_2", "label": "Journey heading, line 2", "default": "A lot more green." },
    { "type": "textarea", "id": "journey_description", "label": "Journey description", "default": "Good gardens grow one thoughtful step at a time. Find a simple rhythm that feels right for your space." },
    { "type": "text", "id": "journey_button_label", "label": "Journey button label", "default": "Explore plant care" },
    { "type": "url", "id": "journey_button_link", "label": "Journey button link" },
    { "type": "image_picker", "id": "journey_image", "label": "Journey feature image" },
    { "type": "text", "id": "journey_image_alt", "label": "Journey image description", "default": "A thriving home vegetable garden with fresh tomatoes and herbs" },
    { "type": "text", "id": "journey_photo_kicker", "label": "Image small label", "default": "GROW SOMETHING GOOD" },
    { "type": "text", "id": "journey_photo_caption", "label": "Image caption", "default": "A little space. A whole lot of life." },
    { "type": "header", "content": "Equipment collage" },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Heading Line 1",
      "default": "precision equipment"
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Heading Line 2",
      "default": "sourcing."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Equipment sourcing is a crucial step, reflecting our commitment to quality and durability. We carefully select professional garden machines, ergonomic hand tools and smart irrigation systems engineered for exceptional performance in caring for green spaces."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "all equipment"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Card 1 Image (Center/Left)"
    },
    {
      "type": "text",
      "id": "caption_1",
      "label": "Card 1 Caption",
      "default": "High-torque brush cutters & tillers"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Card 2 Image (Tall Right)"
    },
    {
      "type": "text",
      "id": "caption_2",
      "label": "Card 2 Caption",
      "default": "Precision turf & lawn care"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Card 3 Image (Desktop Bottom-Left)"
    },
    {
      "type": "text",
      "id": "caption_3",
      "label": "Card 3 Caption",
      "default": "Complex of botanical and wild plants"
    }
  ],
  "blocks": [
    {
      "type": "journey_step",
      "name": "Growing step",
      "settings": [
        { "type": "select", "id": "icon", "label": "Step icon", "default": "seed", "options": [ { "value": "seed", "label": "Seedling" }, { "value": "water", "label": "Water and growth" }, { "value": "bloom", "label": "Bloom" } ] },
        { "type": "text", "id": "title", "label": "Step title", "default": "Make room" },
        { "type": "textarea", "id": "description", "label": "Step description", "default": "Choose a sunny corner, a container, and a plant you love." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "PedhPaudha Machinery"
    }
  ]
}
{% endschema %}
