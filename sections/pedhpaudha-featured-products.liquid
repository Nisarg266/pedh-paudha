{% comment %}
  Shopify catalog cards. Product title, media, description and price always come from Shopify.
{% endcomment %}
{% assign product_collection = section.settings.collection | default: collections.all %}

<section class="pp-products-section" id="products" aria-label="{{ section.settings.accessibility_label | default: 'Products' | escape }}">
  <div class="pp-container">
    <div class="pp-products-grid" id="pp-products-container">
      {% if product_collection != blank and product_collection.products_count > 0 %}
        {% for product in product_collection.products limit: section.settings.products_to_show %}
          {% assign product_category = product.type | default: product.vendor %}
          <article class="pp-product-card{% if forloop.index > 6 %} pp-product-card--desktop-only{% endif %}" data-title="{{ product.title | escape }}" data-category="{{ product_category | escape }} {{ product.tags | join: ' ' | escape }}">
            <div class="pp-prod-image-wrap">
              <a class="pp-prod-image-box" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                {% if product.compare_at_price > product.price %}<span class="pp-prod-badge">{{ section.settings.sale_label | default: 'Sale' | escape }}</span>{% elsif product.available == false %}<span class="pp-prod-badge">{{ section.settings.sold_out_label | default: 'Sold out' | escape }}</span>{% endif %}
                {% if product.featured_image != blank %}
                  {{ product.featured_image | image_url: width: 900 | image_tag: class: 'pp-prod-img', loading: 'lazy', alt: product.featured_image.alt | default: product.title }}
                {% endif %}
              </a>
              <button class="pp-prod-wishlist" type="button" data-product-id="{{ product.id }}" aria-label="Add {{ product.title | escape }} to wishlist"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></button>
            </div>
            <div class="pp-prod-info">
              {% if product_category != blank %}<span class="pp-prod-category">{{ product_category | escape }}</span>{% endif %}
              <h3 class="pp-prod-title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
              {% if product.description != blank %}<p class="pp-prod-tagline">{{ product.description | strip_html | truncate: 115 | escape }}</p>{% endif %}
              <div class="pp-prod-footer">
                <span class="pp-prod-prices">
                  <span class="pp-prod-price">{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}<s class="pp-prod-orig-price">{{ product.compare_at_price | money }}</s>{% endif %}
                </span>
                <a href="{{ product.url }}" class="pp-btn-product">{{ section.settings.product_link_label | default: 'Explore' | escape }}</a>
              </div>
            </div>
          </article>
        {% endfor %}
      {% else %}
        <article class="pp-product-card" data-title="Flower Bloom" data-category="Plant Nutrition">
          <div class="pp-prod-image-wrap"><a class="pp-prod-image-box" href="{{ routes.all_products_collection_url }}" aria-label="Flower Bloom"><span class="pp-prod-badge">Flower Care</span><img src="{{ 'pp-prod-flower-bloom.jpg' | asset_url }}" alt="Flower Bloom plant nutrition bottle" class="pp-prod-img" width="1254" height="1254" loading="lazy"></a><button class="pp-prod-wishlist" type="button" data-product-id="demo-flower-bloom" aria-label="Add Flower Bloom to wishlist"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></button></div>
          <div class="pp-prod-info"><span class="pp-prod-category">Plant Nutrition</span><h3 class="pp-prod-title">Flower Bloom</h3><p class="pp-prod-tagline">A flower-care product in a 100 ml glass bottle.</p><div class="pp-prod-footer"><span class="pp-prod-meta">100 ml · Glass bottle</span><a href="{{ routes.all_products_collection_url }}" class="pp-btn-product">Explore</a></div></div>
        </article>
        <article class="pp-product-card" data-title="Growth Promote" data-category="Plant Nutrition">
          <div class="pp-prod-image-wrap"><a class="pp-prod-image-box" href="{{ routes.all_products_collection_url }}" aria-label="Growth Promote"><span class="pp-prod-badge">Plant Growth</span><img src="{{ 'pp-prod-growth-promote.jpg' | asset_url }}" alt="PedhPaudha Growth Promote bottle" class="pp-prod-img pp-prod-img--photo" width="1200" height="1600" loading="lazy"></a><button class="pp-prod-wishlist" type="button" data-product-id="demo-growth-promote" aria-label="Add Growth Promote to wishlist"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></button></div>
          <div class="pp-prod-info"><span class="pp-prod-category">Plant Nutrition</span><h3 class="pp-prod-title">Growth Promote</h3><p class="pp-prod-tagline">PedhPaudha plant growth enhancer for home gardens.</p><div class="pp-prod-footer"><span class="pp-prod-meta">100 ml bottle</span><a href="{{ routes.all_products_collection_url }}" class="pp-btn-product">Explore</a></div></div>
        </article>
        <article class="pp-product-card" data-title="360 Shield" data-category="Plant Protection">
          <div class="pp-prod-image-wrap"><a class="pp-prod-image-box" href="{{ routes.all_products_collection_url }}" aria-label="360 Shield"><span class="pp-prod-badge">Plant Protection</span><img src="{{ 'pp-prod-360-shield.jpg' | asset_url }}" alt="PedhPaudha 360 Shield plant-care bottle" class="pp-prod-img" width="1254" height="1254" loading="lazy"></a><button class="pp-prod-wishlist" type="button" data-product-id="demo-360-shield" aria-label="Add 360 Shield to wishlist"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></button></div>
          <div class="pp-prod-info"><span class="pp-prod-category">Plant Protection</span><h3 class="pp-prod-title">360 Shield</h3><p class="pp-prod-tagline">A dedicated plant-care product for your growing space.</p><div class="pp-prod-footer"><span class="pp-prod-meta">Plant protection</span><a href="{{ routes.all_products_collection_url }}" class="pp-btn-product">Explore</a></div></div>
        </article>
        <article class="pp-product-card pp-product-card--coming-soon" data-title="Micronutrients" data-category="Micronutrients">
          <div class="pp-prod-image-box pp-prod-image-box--placeholder"><span class="pp-prod-badge">Coming Soon</span><div class="pp-prod-placeholder-art"><svg viewBox="0 0 64 64" fill="none"><path d="M32 54V28m0 10c-12 0-19-7-19-18 12 0 19 7 19 18Zm0-7c0-12 7-19 19-19 0 12-7 19-19 19Z" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Product image<br>coming soon</span></div></div>
          <div class="pp-prod-info"><span class="pp-prod-category">Micronutrients</span><h3 class="pp-prod-title">Micronutrients</h3><p class="pp-prod-tagline">The 500 ml bottle is in development.</p><div class="pp-prod-footer"><span class="pp-prod-meta pp-prod-meta--soon">500 ml · Coming soon</span></div></div>
        </article>
        <article class="pp-product-card" data-title="Planters" data-category="Planters">
          <div class="pp-prod-image-wrap"><a class="pp-prod-image-box" href="{{ routes.all_products_collection_url }}" aria-label="Planters"><span class="pp-prod-badge">Planters</span><img src="{{ 'pp-prod-planters.jpg' | asset_url }}" alt="Vertical planters filled with flowers" class="pp-prod-img pp-prod-img--photo" width="1200" height="1600" loading="lazy"></a><button class="pp-prod-wishlist" type="button" data-product-id="demo-planters" aria-label="Add planters to wishlist"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></button></div>
          <div class="pp-prod-info"><span class="pp-prod-category">Planters</span><h3 class="pp-prod-title">Planters</h3><p class="pp-prod-tagline">Colorful vertical planters for flowers and greenery.</p><div class="pp-prod-footer"><span class="pp-prod-meta">For home gardens</span><a href="{{ routes.all_products_collection_url }}" class="pp-btn-product">Explore</a></div></div>
        </article>
        <article class="pp-product-card" data-title="Seasonal Fruit & Vegetable Seeds" data-category="Seasonal Seeds">
          <div class="pp-prod-image-wrap"><a class="pp-prod-image-box" href="{{ routes.all_products_collection_url }}" aria-label="Seasonal Fruit and Vegetable Seeds"><span class="pp-prod-badge">Seasonal</span><img src="{{ 'pp-prod-seasonal-seeds.jpg' | asset_url }}" alt="Seasonal fruit and vegetable seed packets" class="pp-prod-img" width="1254" height="1254" loading="lazy"></a><button class="pp-prod-wishlist" type="button" data-product-id="demo-seasonal-seeds" aria-label="Add seasonal seeds to wishlist"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg></button></div>
          <div class="pp-prod-info"><span class="pp-prod-category">Seasonal Seeds</span><h3 class="pp-prod-title">Seasonal Fruit &amp; Vegetable Seeds</h3><p class="pp-prod-tagline">Seasonal varieties for fruit and vegetable gardens.</p><div class="pp-prod-footer"><span class="pp-prod-meta">Grow from seed</span><a href="{{ routes.all_products_collection_url }}" class="pp-btn-product">Explore</a></div></div>
        </article>
        <article class="pp-product-card pp-product-card--coming-soon pp-product-card--desktop-only" data-title="Organic Potting Soil" data-category="Soil Care">
          <div class="pp-prod-image-box pp-prod-image-box--placeholder"><span class="pp-prod-badge">Coming Soon</span><div class="pp-prod-placeholder-art"><span>Product image<br>coming soon</span></div></div><div class="pp-prod-info"><span class="pp-prod-category">Soil Care</span><h3 class="pp-prod-title">Organic Potting Soil</h3><p class="pp-prod-tagline">Product details and launch date coming soon.</p><div class="pp-prod-footer"><span class="pp-prod-meta pp-prod-meta--soon">Coming soon</span></div></div>
        </article>
        <article class="pp-product-card pp-product-card--coming-soon pp-product-card--desktop-only" data-title="Seedling Plug Tray" data-category="Seed Starting">
          <div class="pp-prod-image-box pp-prod-image-box--placeholder"><span class="pp-prod-badge">Coming Soon</span><div class="pp-prod-placeholder-art"><span>Product image<br>coming soon</span></div></div><div class="pp-prod-info"><span class="pp-prod-category">Seed Starting</span><h3 class="pp-prod-title">Seedling Plug Tray</h3><p class="pp-prod-tagline">Product details and launch date coming soon.</p><div class="pp-prod-footer"><span class="pp-prod-meta pp-prod-meta--soon">Coming soon</span></div></div>
        </article>
      {% endif %}
    </div>

    {% if section.settings.show_view_all %}
      <div class="pp-products-more">
        <a href="{{ product_collection.url | default: routes.all_products_collection_url }}" class="pp-btn-shop">
          <span>{{ section.settings.view_all_label | default: 'View All Products' | escape }}</span>
          <span class="pp-btn-arrow-circle" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "PedhPaudha Products",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Shopify product collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 1, "max": 12, "step": 1, "default": 8 },
    { "type": "text", "id": "accessibility_label", "label": "Section accessibility label", "default": "PedhPaudha products" },
    { "type": "text", "id": "product_link_label", "label": "Product link label", "default": "Explore" },
    { "type": "text", "id": "sale_label", "label": "Sale badge", "default": "Sale" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out badge", "default": "Sold out" },
    { "type": "text", "id": "empty_state", "label": "Empty collection message", "default": "No products are available in this collection yet." },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view all button", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View all button label", "default": "View All Products" }
  ],
  "presets": [{ "name": "PedhPaudha Products" }]
}
{% endschema %}
